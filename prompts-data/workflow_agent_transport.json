      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Cherche d'abord un numéro de commande dans le message client\n// Format Alltricks : 260507T074339522 ou 260507T074339522A\nconst msg = $json.dernier_message || '';\nconst sfRef = $json.name || '';\nconst match = msg.match(/\\b(\\d{6}[A-Z]\\d{12}[A-Z]?)\\b/);\nconst order_ref = match ? match[1] : sfRef;\n\nreturn {\n  json: {\n    order_ref,\n    contact_email: $json.contact_email || '',\n    case_id: $json.case_id || '',\n    contact_firstname: $json.contact_firstname || '',\n    langue: $json.langue || 'fr',\n    dernier_message: $json.dernier_message || '',\n    site: $json.site_de_la_commande || 'Alltricks',\n    motif_contact: $json.motif_contact || '',\n    montant_ttc: $json.montant_ttc || 0\n  }\n};"
      },
