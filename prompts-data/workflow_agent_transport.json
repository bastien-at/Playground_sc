    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.output || '').trim();\nlet result = {\n  out_of_scope: false,\n  needs_human: true,\n  order_reference: null,\n  tracking_number: null,\n  situation_category: 'PAS_DE_TRACKING',\n  situation_detail: 'Erreur de parsing de la réponse IA',\n  email_subject: '',\n  email_body: '',\n  language: 'fr'\n};\n\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    const parsed = JSON.parse(match[0]);\n    result = {\n      out_of_scope: parsed.out_of_scope || false,\n      needs_human: parsed.needs_human || false,\n      order_reference: parsed.order_reference || null,\n      tracking_number: parsed.tracking_number || null,\n      situation_category: parsed.situation_category || 'PAS_DE_TRACKING',\n      situation_detail: parsed.situation_detail || '',\n      email_subject: parsed.email_subject || '',\n      email_body: parsed.email_body || '',\n      language: parsed.language || 'fr'\n    };\n  }\n} catch(e) {\n  console.error('Parsing JSON échoué:', e.message);\n}\n\nreturn {\n  json: {\n    ...result,\n    contact_email: $('Extraire référence commande').item.json.contact_email,\n    case_id: $('Extraire référence commande').item.json.case_id\n  }\n};"
      },
