    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output || '';\nconst caseDetail = $('Get detail of a case').item.json;\n\nlet contact = {};\ntry {\n  contact = $('Get detail of contact').item?.json || {};\n} catch(e) {\n  contact = {};\n}\n\nlet classification = {\n  categorie: 'AUTRES QUESTIONS',\n  sous_categorie: 'Toutes autres demandes',\n  langue: 'fr',\n  motif_contact: 'AUT-Appel coupé'\n};\n\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    const parsed = JSON.parse(match[0]);\n    classification = {\n      categorie: parsed.categorie || classification.categorie,\n      sous_categorie: parsed.sous_categorie || classification.sous_categorie,\n      priorite: parsed.priorite || classification.priorite,\n      action_recommandee: parsed.action_recommandee || classification.action_recommandee,\n      langue: parsed.langue || classification.langue,\n      motif_contact: parsed.motif_contact || classification.motif_contact\n    };\n  }\n} catch(e) {\n  console.error('❌ Parsing classification échoué:', e);\n}\n\nreturn {\n  json: {\n    case_id: caseDetail.Id,\nfrom_address: caseDetail.SuppliedEmail || caseDetail.Email__c || '',    subject: caseDetail.Subject,\n    dernier_message: caseDetail.Dernier_message__c,\n    origine: caseDetail.Origin,\n    created_date: caseDetail.CreatedDate,\n    contact_firstname: contact.FirstName || '',\n    contact_lastname: contact.LastName || '',\ncontact_email: contact.Email || caseDetail.SuppliedEmail || caseDetail.Email__c || '',\n    classification\n  }\n};"
      },
